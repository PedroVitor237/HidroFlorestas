{
  "name": "hidro-florestas-fullstack",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "create-super-admin": "tsx ./src/app/api/server/scripts/superadmin.ts",
    "lint": "eslint",
    "test:fixtures:auth": "tsx tests/fixtures/auth-users.ts",
    "test:unit": "node --import=tsx --test tests/unit/*.test.ts tests/unit/*.test.tsx",
    "test:integration": "node --import=tsx scripts/imp006-test-runner.ts integration",
    "test:integration:ihfr-insufficiency": "node --import=tsx scripts/imp006-test-runner.ts ihfr-insufficiency",
    "test:contract": "node --import=tsx scripts/imp006-test-runner.ts contract",
    "test:ihfr:audit": "node --import=tsx scripts/imp006-audit-schemas.ts list",
    "test:ihfr:audit:assert-zero": "node --import=tsx scripts/imp006-audit-schemas.ts assert-zero",
    "test:e2e": "playwright test",
    "test:e2e:ihfr": "node --import=tsx scripts/imp006-local-e2e.ts",
    "test:e2e:ihfr:full-ui": "node --import=tsx scripts/imp006-full-ui-e2e.ts",
    "test:e2e:https": "node --import=tsx tests/e2e/run-auth-https.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "test:migration": "node --import=tsx scripts/imp006-test-runner.ts migration"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-better-sqlite3": "7.4.2",
    "@prisma/adapter-neon": "7.4.2",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "1.9.4",
    "lucide-react": "^1.16.0",
    "next": "^16.1.6",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "5.0.0",
    "readline": "^1.3.0",
    "sonner": "^2.0.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "24.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.6",
    "prisma": "7.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "yaml": "2.8.1"
  }
}
