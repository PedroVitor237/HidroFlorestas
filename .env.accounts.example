# Copy only reviewed values into a private configuration for the isolated phase.
# Secrets and recipient addresses deliberately have no example values.
# In private dotenv files, wrap JSON keyrings in single quotes. Do not escape
# JSON double quotes as a JSON.stringify string: dotenv does not decode them.
DATABASE_URL=
JWT_SECRET=
APP_PUBLIC_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=
MAIL_PAYLOAD_ENCRYPTION_KEYS=
MAIL_PAYLOAD_ACTIVE_KEY_ID=
MAIL_IDEMPOTENCY_KEY=
MAIL_WORKER_SECRET=
ACCOUNT_PROOF_KEYS=
ACCOUNT_PROOF_ACTIVE_KEY_ID=
ACCOUNT_REQUEST_KEY=
ACCOUNT_POLICY_ENABLED=1
ACCOUNT_TRUSTED_INGRESS=vercel
ACCOUNT_TESTER_ALLOWLIST=
ACCOUNT_VERIFICATION_TTL_SECONDS=900
ACCOUNT_VERIFICATION_ATTEMPTS=5
ACCOUNT_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_VERIFICATION_SENDS_PER_HOUR=5
ACCOUNT_RESET_TTL_SECONDS=1800
ACCOUNT_RESET_REQUESTS_PER_HOUR=3
ACCOUNT_GLOBAL_REQUESTS_PER_HOUR=100
