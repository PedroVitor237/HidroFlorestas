datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  firstName String
  lastName  String
  password  String
  role      UserRole   @default(USER)
  image     String     @default("")
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isAdmin   Boolean    @default(false)

  laboratoryRooms                  LaboratoryRoom[]
  researchersLinked                ResearchersLinked[]
  collectionAreas                  CollectionArea[]
  collectionData                   CollectionData[]
  environmentalMeasurementSets     EnvironmentalMeasurementSet[]
  experimentalIHFRInputSupplements ExperimentalIHFRInputSupplement[]
  experimentalIHFROperations       IHFRDiagnosisOperation[]          @relation("ExperimentalIHFROperationActor")
  experimentalIHFRLifecycleEvents  IHFRDiagnosisLifecycleEvent[]     @relation("ExperimentalIHFRLifecycleActor")
}

enum UserRole {
  USER
  ADMIN
  DEVELOPER
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

model LaboratoryRoom {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  imageBanner String   @default("")
  isActive    Boolean  @default(true)
  accessCode  String   @unique

  researchersLinked          ResearchersLinked[]
  collectionAreas            CollectionArea[]
  collectionData             CollectionData[]
  experimentalIHFROperations IHFRDiagnosisOperation[]
}

enum LaboratoryMembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model ResearchersLinked {
  id               String                   @unique @default(uuid())
  role             LaboratoryMembershipRole @default(MEMBER)
  userId           String
  laboratoryRoomId String

  user           User           @relation(fields: [userId], references: [id])
  laboratoryRoom LaboratoryRoom @relation(fields: [laboratoryRoomId], references: [id])

  @@id([userId, laboratoryRoomId])
  @@index([laboratoryRoomId, role])
}

model CollectionArea {
  id               String   @id @default(uuid())
  name             String
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)
  userId           String
  laboratoryRoomId String
  latitude         Decimal  @db.Decimal(8, 6)
  longitude        Decimal  @db.Decimal(9, 6)
  municipality     String?
  state            String?
  cep              String?
  landType         String?
  description      String?  @map("descriptionLandType")

  user           User           @relation(fields: [userId], references: [id])
  laboratoryRoom LaboratoryRoom @relation(fields: [laboratoryRoomId], references: [id])

  collectionData             CollectionData[]
  experimentalIHFROperations IHFRDiagnosisOperation[]

  @@unique([id, laboratoryRoomId])
  @@index([laboratoryRoomId, createdAt])
}

enum LandType {
  FOREST
  AGROFORESTRY
  CROPLAND
  PASTURE
  DEGRADED_PASTURE
  BARE_SOIL
  URBAN
  OTHERS
}

model CollectionData {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  collectionAreaId String
  laboratoryRoomId String
  userId           String
  observations     String?
  occurredAt       DateTime? @db.Timestamptz(3)
  occurrenceOffset String?   @db.VarChar(6)
  confirmedAt      DateTime? @db.Timestamptz(3)
  confirmationKey  String?

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  laboratoryRoom LaboratoryRoom @relation(fields: [laboratoryRoomId], references: [id], onDelete: Restrict)
  collectionArea CollectionArea @relation(fields: [collectionAreaId, laboratoryRoomId], references: [id, laboratoryRoomId], onDelete: Restrict)

  waterData                        WaterData[]
  soilData                         SoilData[]
  vegetationData                   VegetationData[]
  terrainData                      TerrainData[]
  diagnoses                        IHFRDiagnosis[]
  environmentalMeasurementSet      EnvironmentalMeasurementSet?
  experimentalIHFRInputSupplements ExperimentalIHFRInputSupplement[]
  experimentalIHFRDiagnoses        ExperimentalIHFRDiagnosis[]
  currentExperimentalIHFRDiagnosis CurrentExperimentalIHFRDiagnosis?
  experimentalIHFROperations       IHFRDiagnosisOperation[]
  experimentalIHFRLifecycleEvents  IHFRDiagnosisLifecycleEvent[]

  @@unique([userId, confirmationKey])
  @@index([collectionAreaId, laboratoryRoomId])
}

model IHFRDiagnosis {
  id               String            @id @default(uuid())
  collectionDataId String
  ihfrScore        Float
  ihfrClass        IHFRClass
  waterScore       Float
  soilScore        Float
  vegetationScore  Float
  territoryScore   Float
  dataQuality      LevelBasicDefault
  algorithmVersion String            @default("1.0.0")
  explanationAI    String?

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

enum IHFRClass {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model WaterData {
  id               String @id @default(uuid())
  collectionDataId String @unique

  waterSourceType   WaterSourceType
  hasSpring         Boolean
  wellDepth_m       Float?
  waterAvailability WaterAvailability
  salinityIndicator SalinityIndicator?

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

model SoilData {
  id               String @id @default(uuid())
  collectionDataId String @unique

  soilTexture           SoilTexture
  infiltrationRate_mm_h Float
  compactionLevel       LevelBasicDefault
  erosionSigns          ErosionSigns
  soilExposedPercent    Float?

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

model VegetationData {
  id               String @id @default(uuid())
  collectionDataId String @unique

  vegetationCoverPercent Float
  fragmentationLevel     LevelBasicDefault
  hasRiparian_app        Boolean?
  landscapeDegradation   LevelBasicDefault

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

model TerrainData {
  id               String @id @default(uuid())
  collectionDataId String @unique

  drainage_density Float?
  elevation_m      Float?
  slopePercent     Float?

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

// FALTA O ENTIDADE DE ALERTAS

// ENUMS
enum LevelBasicDefault {
  LOW
  MODERATE
  HIGH
}

enum WaterSourceType {
  RIVER_STREAM
  SPRING
  SHALLOW_WELL
  TUBULA_WELL
  CISTERN
  OTHER
}

enum WaterAvailability {
  PERMANENT
  SEASONAL
  SCARCE
}

enum SalinityIndicator {
  NONE
  SUSPERCTED
  CONFIRMED
}

enum SoilTexture {
  SANDY
  MEDIUM
  CLAYEY
}

enum ErosionSigns {
  NONE
  LAMINAR
  RILLS_GUILLIES
}

model EnvironmentalMeasurementSet {
  id                               String                            @id @default(uuid())
  collectionDataId                 String                            @unique
  userId                           String
  measurementContractVersion       String
  payload                          Json
  payloadHash                      String
  confirmationKey                  String
  confirmedAt                      DateTime                          @db.Timestamptz(3)
  createdAt                        DateTime                          @default(now()) @db.Timestamptz(3)
  collectionData                   CollectionData                    @relation(fields: [collectionDataId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                             User                              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  experimentalIHFRInputSupplements ExperimentalIHFRInputSupplement[]
  experimentalIHFRDiagnoses        ExperimentalIHFRDiagnosis[]

  @@unique([userId, confirmationKey])
  @@index([measurementContractVersion])
}

enum ExperimentalIHFRLandUseType {
  FOREST
  AGROFORESTRY
  CROPLAND
  PASTURE
  DEGRADED_PASTURE
  BARE_SOIL
  URBAN
}

enum IHFRDiagnosisOperationType {
  CREATE_OR_REPLACE
  REVOKE
}

enum IHFRDiagnosisOperationOutcome {
  SUCCEEDED
  INSUFFICIENT_DATA
  INCOMPATIBLE_VERSION
}

enum IHFRDiagnosisLifecycleEventType {
  CREATED_CURRENT
  SUPERSEDED
  REVOKED
}

model ExperimentalIHFRInputSupplement {
  id                            String                      @id @default(uuid())
  collectionDataId              String
  environmentalMeasurementSetId String
  createdByUserId               String
  inputContractVersion          String
  landUseType                   ExperimentalIHFRLandUseType
  provenance                    Json
  payloadHash                   String
  confirmedAt                   DateTime                    @db.Timestamptz(3)
  createdAt                     DateTime                    @default(now()) @db.Timestamptz(3)

  collectionData              CollectionData              @relation(fields: [collectionDataId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  environmentalMeasurementSet EnvironmentalMeasurementSet @relation(fields: [environmentalMeasurementSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser               User                        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  diagnoses                   ExperimentalIHFRDiagnosis[]

  @@unique([collectionDataId, payloadHash])
  @@index([environmentalMeasurementSetId])
  @@index([createdByUserId])
}

model ExperimentalIHFRDiagnosis {
  id                            String            @id @default(uuid())
  collectionDataId              String
  environmentalMeasurementSetId String
  inputSupplementId             String
  rawScore                      Float
  displayScore                  Decimal           @db.Decimal(3, 2)
  ihfrClass                     IHFRClass
  dataQuality                   LevelBasicDefault
  componentScores               Json
  decomposition                 Json
  drivers                       Json
  explanation                   String
  measurementContractVersion    String
  inputContractVersion          String
  mathContractVersion           String
  algorithmVersion              String
  contractHash                  String
  calculatedAt                  DateTime          @db.Timestamptz(3)
  scientificState               String
  createdAt                     DateTime          @default(now()) @db.Timestamptz(3)

  collectionData              CollectionData                    @relation(fields: [collectionDataId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  environmentalMeasurementSet EnvironmentalMeasurementSet       @relation(fields: [environmentalMeasurementSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inputSupplement             ExperimentalIHFRInputSupplement   @relation(fields: [inputSupplementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentPointer              CurrentExperimentalIHFRDiagnosis? @relation("CurrentExperimentalIHFRDiagnosisPointer")
  operations                  IHFRDiagnosisOperation[]          @relation("ExperimentalIHFROperationDiagnosis")
  lifecycleEvents             IHFRDiagnosisLifecycleEvent[]     @relation("ExperimentalIHFRLifecycleDiagnosis")
  replacementEvents           IHFRDiagnosisLifecycleEvent[]     @relation("ExperimentalIHFRLifecycleReplacement")

  @@index([collectionDataId, calculatedAt])
  @@index([environmentalMeasurementSetId])
  @@index([inputSupplementId])
  @@index([mathContractVersion, contractHash])
}

model CurrentExperimentalIHFRDiagnosis {
  collectionDataId String   @id
  diagnosisId      String   @unique
  validFrom        DateTime @db.Timestamptz(3)
  operationId      String   @unique

  collectionData CollectionData            @relation(fields: [collectionDataId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  diagnosis      ExperimentalIHFRDiagnosis @relation("CurrentExperimentalIHFRDiagnosisPointer", fields: [diagnosisId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation      IHFRDiagnosisOperation    @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model IHFRDiagnosisOperation {
  id               String                        @id @default(uuid())
  laboratoryRoomId String
  collectionAreaId String
  collectionDataId String
  actorUserId      String
  idempotencyKey   String
  requestHash      String
  operationType    IHFRDiagnosisOperationType
  outcome          IHFRDiagnosisOperationOutcome
  diagnosisId      String?
  responseSnapshot Json
  createdAt        DateTime                      @default(now()) @db.Timestamptz(3)
  completedAt      DateTime                      @db.Timestamptz(3)

  laboratoryRoom  LaboratoryRoom                    @relation(fields: [laboratoryRoomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collectionArea  CollectionArea                    @relation(fields: [collectionAreaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collectionData  CollectionData                    @relation(fields: [collectionDataId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser       User                              @relation("ExperimentalIHFROperationActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  diagnosis       ExperimentalIHFRDiagnosis?        @relation("ExperimentalIHFROperationDiagnosis", fields: [diagnosisId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentPointer  CurrentExperimentalIHFRDiagnosis?
  lifecycleEvents IHFRDiagnosisLifecycleEvent[]

  @@unique([actorUserId, idempotencyKey])
  @@index([laboratoryRoomId, collectionAreaId, collectionDataId])
  @@index([diagnosisId])
}

model IHFRDiagnosisLifecycleEvent {
  id                     String                          @id @default(uuid())
  collectionDataId       String
  diagnosisId            String
  eventType              IHFRDiagnosisLifecycleEventType
  replacementDiagnosisId String?
  actorUserId            String
  operationId            String
  reason                 String?
  occurredAt             DateTime                        @db.Timestamptz(3)
  evidence               Json

  collectionData       CollectionData             @relation(fields: [collectionDataId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  diagnosis            ExperimentalIHFRDiagnosis  @relation("ExperimentalIHFRLifecycleDiagnosis", fields: [diagnosisId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacementDiagnosis ExperimentalIHFRDiagnosis? @relation("ExperimentalIHFRLifecycleReplacement", fields: [replacementDiagnosisId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser            User                       @relation("ExperimentalIHFRLifecycleActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation            IHFRDiagnosisOperation     @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([collectionDataId, occurredAt])
  @@index([diagnosisId, occurredAt])
  @@index([operationId])
}
