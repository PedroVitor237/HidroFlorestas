datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  firstName String
  lastName  String
  password  String
  role      UserRole   @default(USER)
  image     String     @default("")
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  revision  Int        @default(0)

  laboratoryRooms   LaboratoryRoom[]
  researchersLinked ResearchersLinked[]
  collectionAreas   CollectionArea[]
  collectionData    CollectionData[]
  environmentalMeasurementSets EnvironmentalMeasurementSet[]
  administrativeActions AdministrativeAuditEvent[] @relation("AdministrativeActor")
  administrativeChanges AdministrativeAuditEvent[] @relation("AdministrativeTarget")
}

enum UserRole {
  USER
  ADMIN
  DEVELOPER
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

enum AdministrativeAuditAction {
  ACCOUNT_STATUS_CHANGED
  GLOBAL_ROLE_CHANGED
}

model AdministrativeAuditEvent {
  id             String                    @id @default(uuid())
  targetUserId   String
  actorUserId    String
  action         AdministrativeAuditAction
  beforeValue    String
  afterValue     String
  reason         String                    @db.VarChar(500)
  targetRevision Int
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)

  target User @relation("AdministrativeTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actor  User @relation("AdministrativeActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt, id])
  @@index([actorUserId, createdAt, id])
}

model LaboratoryRoom {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  imageBanner String   @default("")
  isActive    Boolean  @default(true)
  accessCode  String   @unique

  researchersLinked ResearchersLinked[]
  collectionAreas   CollectionArea[]
  collectionData    CollectionData[]
}

enum LaboratoryMembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model ResearchersLinked {
  id               String                   @unique @default(uuid())
  role             LaboratoryMembershipRole @default(MEMBER)
  userId           String
  laboratoryRoomId String

  user           User           @relation(fields: [userId], references: [id])
  laboratoryRoom LaboratoryRoom @relation(fields: [laboratoryRoomId], references: [id])

  @@id([userId, laboratoryRoomId])
  @@index([laboratoryRoomId, role])
}

model CollectionArea {
  id               String   @id @default(uuid())
  name             String
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)
  userId           String
  laboratoryRoomId String
  latitude         Decimal  @db.Decimal(8, 6)
  longitude        Decimal  @db.Decimal(9, 6)
  municipality     String?
  state            String?
  cep              String?
  landType         String?
  description      String?  @map("descriptionLandType")

  user           User           @relation(fields: [userId], references: [id])
  laboratoryRoom LaboratoryRoom @relation(fields: [laboratoryRoomId], references: [id])

  collectionData CollectionData[]

  @@unique([id, laboratoryRoomId])
  @@index([laboratoryRoomId, createdAt])
}

enum LandType {
  FOREST
  AGROFORESTRY
  CROPLAND
  PASTURE
  DEGRADED_PASTURE
  BARE_SOIL
  URBAN
  OTHERS
}

model CollectionData {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  collectionAreaId String
  laboratoryRoomId String
  userId           String
  observations     String?
  occurredAt       DateTime? @db.Timestamptz(3)
  occurrenceOffset String?   @db.VarChar(6)
  confirmedAt      DateTime? @db.Timestamptz(3)
  confirmationKey  String?

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  laboratoryRoom LaboratoryRoom @relation(fields: [laboratoryRoomId], references: [id], onDelete: Restrict)
  collectionArea CollectionArea @relation(fields: [collectionAreaId, laboratoryRoomId], references: [id, laboratoryRoomId], onDelete: Restrict)

  waterData      WaterData[]
  soilData       SoilData[]
  vegetationData VegetationData[]
  terrainData    TerrainData[]
  diagnoses      IHFRDiagnosis[]
  environmentalMeasurementSet EnvironmentalMeasurementSet?

  @@unique([userId, confirmationKey])
  @@index([collectionAreaId, laboratoryRoomId])
}

model IHFRDiagnosis {
  id               String            @id @default(uuid())
  collectionDataId String
  ihfrScore        Float
  ihfrClass        IHFRClass
  waterScore       Float
  soilScore        Float
  vegetationScore  Float
  territoryScore   Float
  dataQuality      LevelBasicDefault
  algorithmVersion String            @default("1.0.0")
  explanationAI    String?

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

enum IHFRClass {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model WaterData {
  id               String @id @default(uuid())
  collectionDataId String @unique

  waterSourceType   WaterSourceType
  hasSpring         Boolean
  wellDepth_m       Float?
  waterAvailability WaterAvailability
  salinityIndicator SalinityIndicator?

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

model SoilData {
  id               String @id @default(uuid())
  collectionDataId String @unique

  soilTexture           SoilTexture
  infiltrationRate_mm_h Float
  compactionLevel       LevelBasicDefault
  erosionSigns          ErosionSigns
  soilExposedPercent    Float?

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

model VegetationData {
  id               String @id @default(uuid())
  collectionDataId String @unique

  vegetationCoverPercent Float
  fragmentationLevel     LevelBasicDefault
  hasRiparian_app        Boolean?
  landscapeDegradation   LevelBasicDefault

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

model TerrainData {
  id               String @id @default(uuid())
  collectionDataId String @unique

  drainage_density Float?
  elevation_m      Float?
  slopePercent     Float?

  collectionData CollectionData @relation(fields: [collectionDataId], references: [id])
}

// FALTA O ENTIDADE DE ALERTAS

// ENUMS
enum LevelBasicDefault {
  LOW
  MODERATE
  HIGH
}

enum WaterSourceType {
  RIVER_STREAM
  SPRING
  SHALLOW_WELL
  TUBULA_WELL
  CISTERN
  OTHER
}

enum WaterAvailability {
  PERMANENT
  SEASONAL
  SCARCE
}

enum SalinityIndicator {
  NONE
  SUSPERCTED
  CONFIRMED
}

enum SoilTexture {
  SANDY
  MEDIUM
  CLAYEY
}

enum ErosionSigns {
  NONE
  LAMINAR
  RILLS_GUILLIES
}

model EnvironmentalMeasurementSet {
  id String @id @default(uuid())
  collectionDataId String @unique
  userId String
  measurementContractVersion String
  payload Json
  payloadHash String
  confirmationKey String
  confirmedAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  collectionData CollectionData @relation(fields: [collectionDataId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([userId, confirmationKey])
  @@index([measurementContractVersion])
}
